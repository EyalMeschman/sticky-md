<Window x:Class="StickyMD.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StickyMD Settings"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
  <!--
    ShowInTaskbar is TRUE here, unlike a note. Notes hide from the taskbar
    because they are desktop furniture; this is a dialog the user opened and
    has to be able to get back to after clicking away from it. With no taskbar
    button and no owner window, an alt+tabbed Settings window would be
    unreachable.

    Deliberately NOT themed by NotePalette. It is app chrome, not a note, and
    theming it would tie a settings dialog to whichever colour the last note
    happened to be. WPF's own default chrome is light regardless of the OS
    theme, so the few fixed colours below (the banner, the hotkey warnings) sit
    on a light surface either way.
  -->
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="SectionHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,4" />
    </Style>
    <Style TargetType="TextBlock" x:Key="FieldLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="16">

    <!-- The startup banner: a notes root that could not be created, or a
         failed save. Collapsed unless there is something to say. -->
    <Border x:Name="Banner" Visibility="Collapsed"
            Background="#FFF4E5" BorderBrush="#E0A800" BorderThickness="1"
            CornerRadius="4" Padding="8" Margin="0,0,0,8">
      <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="#5C4400" />
    </Border>

    <TextBlock Text="Notes folder" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4"
               Text="Every note is a .md file in this folder. Notes already open stay where they are." />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="NotesRootBox" Grid.Column="0" VerticalContentAlignment="Center" />
      <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…"
              Width="80" Margin="6,0,0,0" />
    </Grid>

    <TextBlock Text="New note defaults" Style="{StaticResource SectionHeader}" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" Width="60" />
      <StackPanel x:Name="ColorSwatches" Orientation="Horizontal" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" Width="60" />
      <Slider x:Name="OpacitySlider" Width="200" Minimum="30" Maximum="100"
              TickFrequency="5" IsSnapToTickEnabled="True"
              VerticalAlignment="Center" />
      <TextBlock x:Name="OpacityReadout" Width="44" Margin="8,0,0,0"
                 VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="Size" Style="{StaticResource FieldLabel}" Width="60" />
      <TextBox x:Name="WidthBox" Width="60" VerticalContentAlignment="Center" />
      <TextBlock Text="×" Margin="6,0" VerticalAlignment="Center" />
      <TextBox x:Name="HeightBox" Width="60" VerticalContentAlignment="Center" />
      <TextBlock Text="px" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
    </StackPanel>
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Text" Style="{StaticResource FieldLabel}" Width="60" />
      <!-- Minimum and Maximum are set in code from StateValidator, so this
           slider cannot offer a size the validator would then correct. -->
      <Slider x:Name="FontSizeSlider" Width="200"
              TickFrequency="1" IsSnapToTickEnabled="True"
              VerticalAlignment="Center" />
      <TextBlock x:Name="FontSizeReadout" Width="44" Margin="8,0,0,0"
                 VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="68,4,0,0"
               Text="These apply to notes you create from now on. To change one note, use its ⋯ menu." />

    <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="Theme" Style="{StaticResource FieldLabel}" Width="60" />
      <ComboBox x:Name="ThemeBox" Width="140" />
    </StackPanel>

    <TextBlock Text="Global hotkeys" Style="{StaticResource SectionHeader}" />
    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,4"
               Text="Click a box and press the combination you want. It needs at least one of Ctrl, Alt, Shift or Win." />
    <Grid Margin="0,0,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Text="New note"
                 Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="NewNoteHotkeyBox" Grid.Row="0" Grid.Column="1"
               IsReadOnly="True" IsReadOnlyCaretVisible="False"
               VerticalContentAlignment="Center" Margin="0,0,0,4" />
      <TextBlock x:Name="NewNoteHotkeyFlag" Grid.Row="0" Grid.Column="2"
                 Foreground="#B00020" TextWrapping="Wrap" Margin="8,0,0,0"
                 VerticalAlignment="Center" />

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Show / hide all"
                 Style="{StaticResource FieldLabel}" />
      <TextBox x:Name="ShowHideHotkeyBox" Grid.Row="1" Grid.Column="1"
               IsReadOnly="True" IsReadOnlyCaretVisible="False"
               VerticalContentAlignment="Center" />
      <TextBlock x:Name="ShowHideHotkeyFlag" Grid.Row="1" Grid.Column="2"
                 Foreground="#B00020" TextWrapping="Wrap" Margin="8,0,0,0"
                 VerticalAlignment="Center" />
    </Grid>

    <TextBlock Text="Images and startup" Style="{StaticResource SectionHeader}" />
    <CheckBox x:Name="RemoteImagesCheck" Margin="0,0,0,6"
              Content="Load images from the internet in notes" />
    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="20,0,0,6"
               Text="Off by default. Notes sync, so a shared note containing a tracking image must not make network requests just because StickyMD rendered it." />
    <CheckBox x:Name="StartupCheck" Content="Launch StickyMD when I sign in" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="SaveButton" Content="Save" IsDefault="True"
              Width="80" Margin="0,0,6,0" />
      <!--
        NOT IsCancel. This window is shown non-modal, so notes stay usable
        while it is open, and IsCancel routes through Window.DialogResult,
        which only a ShowDialog window has. Escape is wired in code-behind
        instead.
      -->
      <Button x:Name="CancelButton" Content="Cancel" Width="80" />
    </StackPanel>
  </StackPanel>
</Window>
