<Application x:Class="StickyMD.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <Style x:Key="HeaderGlyph" TargetType="Button">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Arrow" />

      <!--
        The glyphs had NO Foreground until the app was run by hand, so they
        took Button's default near-black in every theme and were invisible on
        any dark note. White is not the fix either: it would then vanish on
        Yellow/Light. Both brushes come from the palette via NoteWindow's
        Resources (see ApplyTheme), which is the same ChromeFg the title text
        already uses, so the glyphs are dark on light chrome and light on dark
        chrome for all fourteen colour/mode combinations.
      -->
      <Setter Property="Foreground" Value="{DynamicResource HeaderGlyphFg}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!--
                  Was a fixed 15% black, which is invisible on a dark note.
                  HeaderGlyphHover is ChromeFg at low alpha, so the hover
                  wash always contrasts with the chrome it sits on.
                -->
                <Setter TargetName="Chrome" Property="Background"
                        Value="{DynamicResource HeaderGlyphHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
