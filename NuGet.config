<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped package sources.

  This machine has NO package sources configured globally: %APPDATA%\NuGet\nuget.config
  contains an explicitly emptied <packageSources> block (dated 2023-10-28). That is a
  deliberate machine-wide posture, not a default, and it is left untouched.

  This file enables nuget.org for THIS repository only. Every other project on the
  machine still resolves zero sources. Delete this file to revert.

  <clear /> makes resolution deterministic by discarding sources inherited from
  parent or user-level configs before adding ours.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
